# Copy to functions/.env (or .env.<projectId>) and fill in.
# Non-secret string params (defineString). Secrets go through
#   firebase functions:secrets:set INSTAGRAM_APP_SECRET

# Kakao Developers > 내 애플리케이션 > 앱 키 페이지의 "앱 ID" (숫자)
KAKAO_APP_ID=

# Instagram (Meta) app id and the exact redirect URI registered in the Meta console.
# Redirect URI = deployed URL of instagramAuthRedirect, e.g.
#   https://asia-northeast3-<projectId>.cloudfunctions.net/instagramAuthRedirect
INSTAGRAM_APP_ID=
INSTAGRAM_REDIRECT_URI=

# Location of the default Realtime Database instance (RTDB triggers must run
# in the same location as the instance). e.g. us-central1, asia-southeast1, europe-west1
RTDB_REGION=us-central1
